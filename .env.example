# Postgres connection string used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/landshark?schema=public"

# Base URL of this app (used by NextAuth for callback URLs)
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# From your Strava API application: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""

# Any random string you choose; Strava echoes it back during webhook
# subscription verification so we know the request is really from Strava.
STRAVA_WEBHOOK_VERIFY_TOKEN=""

# Publicly reachable HTTPS base URL for the webhook subscription scripts
# (e.g. your deployed domain, or an ngrok URL while developing locally).
APP_URL="https://your-deployed-domain.example.com"
